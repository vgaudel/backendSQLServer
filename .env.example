# --- Serveur HTTP ---------------------------------------------------------
PORT=3003

# --- Connexion SQL Server (base MOBILESQL) --------------------------------
# 127.0.0.1 (IPv4) plutôt que 'localhost' (peut résoudre en IPv6 ::1).
DB_SERVER=127.0.0.1
DB_PORT=1433
DB_NAME=mobilesql

# Instance nommée (optionnel). Ex: MSSQLSERVER01. Si renseigné en mode
# 'trusted', connexion via Server=DB_SERVER\DB_INSTANCE (SQL Browser requis
# ou mémoire partagée en local). Vide = connexion par DB_SERVER,DB_PORT.
DB_INSTANCE=

# Mode d'authentification :
#   trusted  -> session Windows courante (msnodesqlv8, sans mot de passe)
#   ntlm     -> Windows via tedious (DB_USER / DB_PASSWORD / DB_DOMAIN)
#   default  -> login SQL classique (DB_USER / DB_PASSWORD)
DB_AUTH=trusted

# Pilote ODBC utilisé en mode 'trusted'.
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# Utilisés uniquement en mode 'ntlm' ou 'default'.
DB_USER=
DB_PASSWORD=
DB_DOMAIN=

# Chiffrement TLS (désactivable en local).
DB_ENCRYPT=false
DB_TRUST_CERT=true
